# =============================================================================
# Grafana Cloud credentials — copy to .env and fill in your values.
#
#   cp .env.example .env
#   # edit .env with real values
#   make secrets-apply     # encodes and applies to k8s/secrets.yaml + kubectl apply
#
# Where to find each value:
#   grafana.com → Your Stack → Details / Connection Details
#
# GRAFANA_CLOUD_USER
#   Numeric instance ID shown on the stack overview page.
#   Same value used for all three signals (metrics, logs, traces).
#   Example: 1162129
#
# GRAFANA_CLOUD_API_KEY
#   An Access Policy token created at grafana.com → Security → Access Policies.
#   Required scopes: metrics:write, logs:write, traces:write
#
# GRAFANA_CLOUD_TEMPO_ENDPOINT
#   Stack page → Tempo → Connection details → "URL" field.
#   Include port 443. Do NOT add a path — Alloy uses OTLP gRPC framing.
#   Example: tempo-prod-06-prod-us-central-0.grafana.net:443
#
# GRAFANA_CLOUD_MIMIR_ENDPOINT
#   Stack page → Prometheus → Connection details → "Remote Write Endpoint".
#   Replace the trailing /api/prom/push with /api/v1/otlp
#   (Alloy sends via OTLP HTTP, not Prometheus remote-write, for this exporter).
#   Example: https://prometheus-prod-24-prod-eu-west-2.grafana.net/api/v1/otlp
#
# GRAFANA_CLOUD_LOKI_ENDPOINT
#   Stack page → Loki → Connection details → URL + /loki/api/v1/push
#   Example: https://logs-prod-012.grafana.net/loki/api/v1/push
# =============================================================================

GRAFANA_CLOUD_USER=""
GRAFANA_CLOUD_API_KEY=""
GRAFANA_CLOUD_TEMPO_ENDPOINT=""
GRAFANA_CLOUD_MIMIR_ENDPOINT=""
GRAFANA_CLOUD_LOKI_ENDPOINT=""

GRAFANA_BASE_URL="https://mccaindev.grafana.net"

ARM_CLIENT_ID="***REMOVED***"
ARM_CLIENT_SECRET="***REMOVED***"
ARM_TENANT_ID="59fa7797-abec-4505-81e6-8ce092642190"
ARM_SUBSCRIPTION_ID="f2402ef5-a794-4d6e-ad6b-0de0de7c36a5"

Resource_Group="mf-cc-dt-azrsrp-foundation-prd-rg"
