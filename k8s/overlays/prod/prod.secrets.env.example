# Template for k8s/overlays/prod/prod.secrets.env — copy this file, rename it
# (drop the .example suffix), and fill in real values. prod.secrets.env is
# gitignored; it must never be committed.
#
# These keys replace the placeholder dev credentials in k8s/infra/secrets.yaml's
# db-secrets Secret for the prod overlay only (see kustomization.yaml's
# secretGenerator). Without this file present, `kubectl kustomize`/`apply -k
# k8s/overlays/prod` fails — that's intentional, it's the fail-closed gate.
#
# Format: plain KEY=VALUE, one per line. Kustomize base64-encodes these itself —
# do not pre-encode.
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
GATEWAY_DB_CONNECTION=Server=mysql;Database=gatewaydb;User=gateway;Password=CHANGE_ME;
ORDER_DB_CONNECTION=Host=postgres;Database=orderdb;Username=orderuser;Password=CHANGE_ME;
