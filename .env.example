# =============================================================================
# Grafana Cloud credentials — sourced from Azure Key Vault.
#
# RECOMMENDED: pull directly from AKV (no manual editing needed):
#   make secrets-fetch-akv
#
# MANUAL fallback: copy to .env, fill in values, then apply:
#   cp .env.example .env
#   # edit .env
#   make secrets-apply
#
# Azure Key Vault: mf-cc-dt-azrsrp-prd-kv
# Secret prefix:   grafana-mccaindev-*
# =============================================================================

# ── Azure Service Principal (used by secrets-fetch-akv to authenticate to AKV) ─
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=
Resource_Group=
Azure_KeyVault=

# ── Grafana Cloud API key (shared across all signals) ──────────────────────────
# AKV secret: grafana-mccaindev-cloud-api-key
# grafana.com → Security → Access Policies → token with metrics:write logs:write traces:write
GRAFANA_CLOUD_API_KEY=

# ── Traces → Grafana Cloud Tempo (OTLP gRPC) ───────────────────────────────────
# AKV secret: grafana-mccaindev-cloud-tempo-endpoint  (strip https://, append :443)
# AKV secret: grafana-mccaindev-cloud-tempo-username
# Endpoint format: <host>:443  (gRPC — no https:// prefix)
GRAFANA_CLOUD_TEMPO_ENDPOINT=
GRAFANA_CLOUD_TEMPO_USER=

# ── Metrics → Grafana Cloud Mimir (OTLP HTTP) ──────────────────────────────────
# AKV secret: grafana-mccaindev-cloud-mimir-endpoint  (append /api/v1/otlp)
# AKV secret: grafana-mccaindev-cloud-mimir-username
# Endpoint format: https://<host>/api/v1/otlp
GRAFANA_CLOUD_MIMIR_ENDPOINT=
GRAFANA_CLOUD_MIMIR_USER=

# ── Logs → Grafana Cloud Loki (OTLP HTTP) ──────────────────────────────────────
# AKV secret: grafana-mccaindev-cloud-loki-endpoint  (append /loki/api/v1/push)
# AKV secret: grafana-mccaindev-cloud-loki-username
# Endpoint format: https://<host>/loki/api/v1/push
GRAFANA_CLOUD_LOKI_ENDPOINT=
GRAFANA_CLOUD_LOKI_USER=

# ── Faro RUM → Grafana Cloud Frontend Observability ────────────────────────────
# AKV secret: grafana-mccaindev-faro-collector-url
# The browser pushes RUM events (errors, traces, logs, sessions) to this URL.
# Injected at container startup into assets/env.js → window.__ENV.FARO_URL.
# Leave empty for local k3d — falls back to in-cluster Alloy Faro receiver.
FARO_COLLECTOR_URL=

# AKV secret: grafana-mccaindev-faro-api-key
# Used by the webpack FaroSourceMapUploaderPlugin at build time (not at runtime).
# Set as a CI env var before running `npm run build` in your pipeline:
#   export FARO_API_KEY=$(az keyvault secret show --vault-name ... --name grafana-mccaindev-faro-api-key --query value -o tsv)
#   npm run build
# Stored in the K8s secret for reference; not mounted in any container.
FARO_API_KEY=
