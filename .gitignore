# NOTE: .env is tracked here by monorepo convention (see root .gitignore) —
# it scaffolds Grafana Cloud + Azure credentials for the learning lab. Treat
# values as public; rotate / replace anything ever committed with real creds.
#
# zcert.crt is local-only and ignored. Rendered Helm values under
# k8s/monitoring/grafana-helm/generated/ are tracked by monorepo convention.

# .NET build output
src/**/bin/
src/**/obj/
src/**/TestResults/

# Python bytecode and caches
src/**/__pycache__/
src/**/*.pyc
src/**/.pytest_cache/
scripts/**/__pycache__/
scripts/**/*.pyc

# Angular / frontend build artefacts
src/frontend/coverage/
src/frontend/out-tsc/
src/frontend/dist/
src/frontend/.angular/
src/frontend/node_modules/

# Python virtual environments
src/**/.venv/

# Backup files created by credential fetch scripts
*.bak

# JetBrains Rider IDE cache
*.lscache

zcert.crt
.env

# Real prod DB credentials for k8s/overlays/prod's secretGenerator. Never commit —
# ship only prod.secrets.env.example. Missing this file makes
# `kubectl kustomize k8s/overlays/prod` fail loudly instead of silently inheriting
# base's dev placeholder credentials.
k8s/overlays/prod/prod.secrets.env

# Personal Claude Code overrides — not shared with the team.
.claude/settings.local.json
